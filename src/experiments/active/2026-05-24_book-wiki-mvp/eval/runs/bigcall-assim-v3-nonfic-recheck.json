    {
      "id": "n19",
      "kind": "concept",
      "parentID": "n16",
      "position": 1,
      "name": "머뭇거림·중단",
      "charter": "포함: 멈춤·중단·머뭇거림의 필요성을 말하는 문장. 제외: 멈추지 않는 활동 자체는 순수한 활동성으로.",
      "gloss": "저자는 이 잠깐의 멈춤이 있어야 활동이 단순 노동으로 떨어지지 않는다고 본다.\n\n잠깐 멈춰서 다른 길이 있는지 둘러보는 것.",
      "sourcePages": [],
      "highlightID": null,
