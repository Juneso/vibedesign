# 책 검색 API 키 — Vercel 배포 시 환경변수로 등록.
# 로컬에서는 `vercel dev` 또는 `.env.local` 로 주입.
# 키 없이도 Google Books로 폴백 동작은 함.

# 카카오 디벨로퍼스 → 내 애플리케이션 → REST API 키 (즉시 발급, 100k/일)
KAKAO_REST_KEY=

# 알라딘 OpenAPI → TTBKey (승인 영업일 1~3일, 5k/일)
ALADIN_TTB_KEY=

# Firebase 웹 앱 config (콘솔 → 프로젝트 설정 → 내 앱 → 웹 앱 에서 발급)
# 프로덕션 프로젝트가 아닌 실험/테스트 전용 프로젝트를 따로 만들어 사용할 것.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
